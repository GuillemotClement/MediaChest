# Réseau local uniquement. Même URL dans le navigateur et APP_URL, sans slash final.
APP_URL=http://raspberrypi.local:8081
APP_PORT=8081
BIND_ADDRESS=0.0.0.0
# Valeurs aléatoires générées par scripts/prod-init.sh (hexadécimal pour PostgreSQL).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
ADMIN_INITIAL_PASSWORD=
# TMDB API Read Access Token, conservé exclusivement côté serveur.
TMDB_READ_ACCESS_TOKEN=
