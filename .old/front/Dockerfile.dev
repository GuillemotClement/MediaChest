FROM node:24.11.0-alpine AS build 
WORKDIR /app 
RUN corepack enable && corepack prepare pnpm@12.16.1 --activate 
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./ 
RUN pnpm install --frozen-lockfile 
COPY . . 
RUN pnpm build 

EXPOSE 5173 
CMD ["pnpm", "run", "dev", "--", "host"]
